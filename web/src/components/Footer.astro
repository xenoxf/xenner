---
import Brand from './Brand.astro';
import { GUIDE } from '../data/guide';
import { REPO } from '../config';

const year = new Date().getFullYear();
/* La página actual no se enlaza a sí misma en el pie. */
const elsewhere = GUIDE.filter((page) => page.path !== Astro.url.pathname);
---

<footer class="foot">
  <div class="shell">
    <div class="foot__top">
      <div class="foot__brand">
        <Brand />
        <p>Un editor de notas que trabaja sobre una carpeta de Markdown en tu ordenador.</p>
      </div>

      <nav class="foot__col" aria-label="Producto">
        <h2>Producto</h2>
        <a href="/#editor">El editor</a>
        <a href="/#organize">Carpetas</a>
        <a href="/#look">Apariencia</a>
      </nav>

      <nav class="foot__col" aria-label="Documentación">
        <h2>Documentación</h2>
        {elsewhere.map((page) => <a href={page.path}>{page.label}</a>)}
      </nav>

      <nav class="foot__col" aria-label="Proyecto">
        <h2>Proyecto</h2>
        <a href={REPO} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="/instalar/">Cómo se ejecuta ↗</a>
      </nav>
    </div>

    <div class="foot__base">
      <p>MIT · {year}</p>
      <p>Tauri · SolidJS · Rust</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding: clamp(3rem, 6vw, 4.5rem) 0 2.25rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .foot__top {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr;
    gap: clamp(1.75rem, 5vw, 3.5rem);
  }

  .foot__brand p {
    margin-top: 0.85rem;
    max-width: 19rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.65;
  }

  .foot__col {
    display: grid;
    align-content: start;
    gap: 0.1rem;
  }

  .foot__col h2 {
    margin-bottom: 0.6rem;
    color: var(--ink-3);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .foot__col a {
    padding: 0.32rem 0;
    color: var(--ink-2);
    font-size: var(--t-sm);
    transition: color var(--t-fast) var(--ease);
  }

  .foot__col a:hover {
    color: var(--accent-ink);
  }

  .foot__base {
    margin-top: clamp(2.25rem, 5vw, 3rem);
    padding-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--t-xs);
  }

  @media (max-width: 980px) {
    .foot__top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 720px) {
    .foot__top {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
