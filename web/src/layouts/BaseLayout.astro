---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'xenner es un creador de notas de escritorio con una interfaz abierta, diseñada para modificarse con skins editables en archivos de texto.',
  image = '/og-xenner.png',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · xenner` : 'xenner — tus notas, a tu manera';
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImageURL = new URL(image, Astro.site ?? Astro.url);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'xenner',
  description,
  softwareVersion: '0.1.0',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Desktop',
  isAccessibleForFree: true,
  license: 'https://opensource.org/license/mit',
  codeRepository: 'https://github.com/acosador116/xenner',
  url: canonicalURL.toString(),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a100e" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="xenner" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="xenner — creador de notas personalizable" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
