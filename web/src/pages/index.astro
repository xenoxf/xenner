---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProductDemo from '../components/ProductDemo';
import BaseLayout from '../layouts/BaseLayout.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
const specUrl = `${sourceUrl}/blob/main/xenner/docs/SKIN_SPEC.md`;

const principles = [
  {
    number: '01',
    title: 'Elige una superficie',
    text: 'Toolbar, sidebar, botones, input, nota o fondo. Cada parte de la ventana tiene su propio archivo.',
    code: 'skins/mi_piel/background.txt',
  },
  {
    number: '02',
    title: 'Cambia una clave',
    text: 'La sintaxis es lo bastante simple para editarla con calma: clave="valor". Nada de perseguir clases CSS.',
    code: 'accent="#d9ff39"',
  },
  {
    number: '03',
    title: 'Recarga y sigue',
    text: 'Xenner reconstruye la apariencia. Tus notas no forman parte del experimento visual.',
    code: 'status=ready',
  },
];

const safeguards = [
  {
    label: 'LECTURA ACOTADA',
    text: 'El backend solo abre archivos conocidos y rechaza rutas fuera de la carpeta de skins.',
  },
  {
    label: 'CSS CON LÍMITES',
    text: 'El parser rechaza llaves, punto y coma y !important antes de convertir claves en variables CSS.',
  },
  {
    label: 'FALLBACK SIEMPRE',
    text: 'Si una skin falta o se rompe, la skin embebida mantiene la ventana en marcha.',
  },
  {
    label: 'DATOS LOCALES',
    text: 'La versión actual guarda las notas en localStorage dentro de la app. No envía ese contenido a un servidor.',
  },
];

const buildCards = [
  {
    type: 'wide',
    kicker: 'APP_NOTES.EXE',
    title: 'Notas de verdad, no maquetas.',
    text: 'Crear, editar, seleccionar y borrar notas en una ventana de escritorio construida con Tauri, SolidJS, TypeScript y Rust.',
    visual: 'notes',
  },
  {
    type: 'normal',
    kicker: 'SKIN_ENGINE.TXT',
    title: 'La piel se puede abrir.',
    text: 'Frosted Glass y WebCore existen como ejemplos reales, con skins por componente y fallback embebido.',
    visual: 'skins',
  },
  {
    type: 'normal',
    kicker: 'NATIVE_WINDOW.EXE',
    title: 'La ventana se mezcla con el escritorio.',
    text: 'La transparencia nativa de Tauri deja ver el fondo detrás de la interfaz. El blur del sistema depende de la plataforma.',
    visual: 'window',
  },
  {
    type: 'wide dark',
    kicker: 'NOT_INCLUDED.TXT',
    title: 'El foco sigue siendo pequeño.',
    text: 'No hay cuentas, nube, marketplace ni catálogo de plugins. La identidad nace del escritorio, las notas y los archivos TXT.',
    visual: 'none',
  },
];
---

<BaseLayout>
  <Header />

  <main id="contenido">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero__stars" aria-hidden="true"></div>
      <div class="hero__sun" aria-hidden="true"></div>
      <div class="hero__mountains" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__scanlines" aria-hidden="true"></div>

      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="eyebrow">Notas de escritorio / Build 001</p>
          <h1 id="hero-title">
            UN TXT.<br />
            <span>OTRA</span> INTERFAZ.<br />
            <em>0 FILAS DE CÓDIGO.</em>
          </h1>
          <p class="hero__lead">
            Xenner es un editor de notas donde la ventana también se edita. Cambia el fondo,
            la toolbar o los botones con archivos <strong>TXT claros</strong>. Si una skin falla,
            otra mantiene vivo el escritorio.
          </p>

          <div class="button-row">
            <a class="button button--primary" href="#skins">
              TOCAR EL SISTEMA
              <svg viewBox="0 0 18 18" aria-hidden="true">
                <path d="M4 9h10M10 5l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
              </svg>
            </a>
            <a class="button button--secondary" href={sourceUrl} target="_blank" rel="noreferrer">
              VER EL CÓDIGO REAL
              <svg viewBox="0 0 18 18" aria-hidden="true">
                <path d="M6 4h8v8M14 4 4 14" fill="none" stroke="currentColor" stroke-width="2"></path>
              </svg>
            </a>
          </div>
        </div>

        <section class="hero__product" id="producto" aria-labelledby="demo-title">
          <h2 class="visually-hidden" id="demo-title">Vista previa interactiva de Xenner</h2>
          <ProductDemo client:visible />
        </section>
      </div>

      <div class="hero__status" aria-hidden="true">
        <span><i></i> XENNER.OS</span>
        <span>MEMORY: LOCAL</span>
        <span>DISPLAY: 96 DPI</span>
        <span>STATUS: READY_</span>
      </div>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        <span>ABRIR ARCHIVO</span><i>◆</i><span>CAMBIAR CLAVE</span><i>◆</i><span>RECARGAR PIEL</span><i>◆</i><span>SEGUIR ESCRIBIENDO</span><i>◆</i>
        <span>ABRIR ARCHIVO</span><i>◆</i><span>CAMBIAR CLAVE</span><i>◆</i><span>RECARGAR PIEL</span><i>◆</i><span>SEGUIR ESCRIBIENDO</span><i>◆</i>
      </div>
    </div>

    <section class="manual" id="filosofia" aria-labelledby="manual-title">
      <div class="container">
        <div class="manual__heading">
          <div>
            <p class="eyebrow">MANUAL_RÁPIDO.TXT</p>
            <h2 id="manual-title">UNA SKIN EMPIEZA<br />EN UN <em>ARCHIVO.</em></h2>
          </div>
          <div class="manual__intro">
            <span aria-hidden="true">//</span>
            <p>
              No es una paleta encerrada en un desplegable. Es una carpeta con archivos pequeños,
              legibles y-RV para que cualquiera pueda abrir la capucha y tocar la pintura.
            </p>
          </div>
        </div>

        <div class="principle-grid">
          {principles.map((principle) => (
            <article class="principle-card">
              <div class="principle-card__top">
                <span>{principle.number}</span>
              </div>
              <div class="principle-card__icon" aria-hidden="true">
                <i></i><i></i><i></i>
              </div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
              <code>{principle.code}</code>
            </article>
          ))}
        </div>

        <div class="file-window">
          <div class="file-window__copy">
            <span class="file-window__label">EJEMPLO REAL / BACKGROUND.TXT</span>
            <h3>UNA LÍNEA.<br />OTRO MUNDO.</h3>
            <p>
              El parser entiende comentarios y pares de clave/valor. La skin gana donde existe;
              el default embebido cubre lo que falta.
            </p>
            <a href={specUrl} target="_blank" rel="noreferrer">ABRIR SKIN_SPEC.MD ↗</a>
          </div>

          <div class="code-card" aria-label="Ejemplo de configuración de skin">
            <div class="code-card__titlebar">
              <div class="code-card__lights" aria-hidden="true"><i></i><i></i><i></i></div>
              <span>background.txt — BLOCK 01</span>
              <b>TXT</b>
            </div>
            <div class="code-card__tabs" aria-hidden="true">
              <span>background.txt <b>×</b></span><span>+ nuevo</span>
            </div>
            <pre><code><span class="code-comment"># una noche de 1998 que sobrevivió al futuro</span>
+<span class="code-key">background</span>=<span class="code-value">"#111018"</span>
+<span class="code-key">blur</span>=<span class="code-value">"0px"</span>
+<span class="code-key">text</span>=<span class="code-value">"#fff8dc"</span>
+<span class="code-key">accent</span>=<span class="code-value">"#d9ff39"</span>

<span class="code-comment"># guardar. recargar. Voilà.</span></code></pre>
            <div class="code-card__footer"><span>Ln 1, Col 1</span><span>UTF-8 / TXT</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="system" id="skins" aria-labelledby="system-title">
      <div class="system__matrix" aria-hidden="true"></div>
      <div class="container">
        <div class="system__heading">
          <div>
            <p class="eyebrow">LIBERTAD CON CABLES</p>
            <h2 id="system-title">CAMBIA TODO.<br /><em>ROMPE MENOS.</em></h2>
          </div>
          <div class="system__scope">
            <span aria-hidden="true">!</span>
            <p>
              Una skin rota puede arruinar el experimento, pero no debería dejarte sin escribir.
              Por eso la lectura, el parser y el fallback tienen límites visibles.
            </p>
          </div>
        </div>

        <div class="safeguard-grid">
          {safeguards.map((item, index) => (
            <article class="safeguard-card">
              <div class="safeguard-card__top">
                <span>REGLA {String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="safeguard-card__number" aria-hidden="true">0{index + 1}</div>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="fallback-line">
          <strong class="fallback-line__label">FALLBACK</strong>
          <p><strong>Principio de continuidad:</strong> si una skin se rompe, xenner vuelve al default embebido.</p>
          <a href={specUrl} target="_blank" rel="noreferrer">LEER SPEC ↗</a>
        </div>
      </div>
    </section>

    <section class="build" id="construccion" aria-labelledby="build-title">
      <div class="build__paper" aria-hidden="true"></div>
      <div class="container">
        <div class="build__heading">
          <div>
            <p class="eyebrow">CONTENTS / PRODUCTO REAL</p>
            <h2 id="build-title">ESTO NO ES<br />UN <em>ROADMAP FANTASMA.</em></h2>
          </div>
          <div class="build__manifest">
            <span>APP_MANIFEST.LOG</span>
            <p>
              La web enseña lo que ya vive en el código. Las funciones que todavía no existen
              se quedan fuera de las promesas.
            </p>
          </div>
        </div>

        <div class="build__grid">
          {buildCards.map((card) => (
            <article class:list={['build-card', `build-card--${card.type.replace(' ', '-')}`]}>
              <div class="build-card__top">
                <span>{card.kicker}</span>
              </div>

              <div class="build-card__body">
                <h3>{card.title}</h3>
                <p>{card.text}</p>

                {card.visual === 'notes' && (
                  <div class="build-card__notes" aria-hidden="true">
                    <div class="build-card__note-sidebar">
                      <span>▰ 03 notas</span>
                      <i class="active"></i><i></i><i></i>
                    </div>
                    <div class="build-card__note-page">
                      <b>UNA IDEA<br />MÁS</b>
                      <span></span><span></span><span></span><span></span>
                    </div>
                  </div>
                )}

                {card.visual === 'skins' && (
                  <div class="build-card__swatches" aria-label="Colores de las skins de ejemplo">
                    <i></i><i></i><i></i><i></i>
                    <span>FROSTED / WEBCORE</span>
                  </div>
                )}

                {card.visual === 'window' && (
                  <div class="build-card__native-window" aria-hidden="true">
                    <div><i></i><i></i><i></i><span>xenner — transparent window</span></div>
                    <p>TAURI / NATIVE / 01</p>
                  </div>
                )}

                {card.visual === 'none' && (
                  <div class="build-card__none" aria-hidden="true">
                    <span>NO</span><i></i><i></i><i></i>
                    <b>cuentas ✕ &nbsp; nube ✕ &nbsp; plugins ✕</b>
                  </div>
                )}
              </div>

              {card.visual === 'none' && (
                <div class="build-card__footer">
                  <span>Fuente pública</span>
                  <a href={sourceUrl} target="_blank" rel="noreferrer">COMPROBAR EN EL REPO ↗</a>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="closing__sun" aria-hidden="true"></div>
      <div class="closing__grid" aria-hidden="true"></div>
      <div class="closing__scanlines" aria-hidden="true"></div>
      <div class="closing__symbols" aria-hidden="true"><span>✦</span><span>＋</span><span>⌁</span><span>★</span></div>

      <div class="container closing__inner">
        <p class="eyebrow">PRÓXIMO COMANDO</p>
        <h2 id="closing-title">ABRE UN TXT.<br /><em>ENCIENDE TODO.</em></h2>
        <p>Lee el SkinEngine, cambia una clave y deja que xenner se parezca a tu forma de pensar.</p>
        <div class="button-row">
          <a class="button button--primary" href={sourceUrl} target="_blank" rel="noreferrer">
            ABRIR XENNER EN GITHUB
            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M6 4h8v8M14 4 4 14" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
          </a>
          <a class="button button--secondary" href="#inicio">VOLVER AL INICIO ↑</a>
        </div>
        <div class="closing__command" aria-hidden="true">
          <span>&gt;</span> C:\XENNER&gt; edit background.txt <i>█</i>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    color: var(--paper-bright);
    background: #4b2696;
  }

  .hero__stars {
    position: absolute;
    inset: 0 0 36%;
    opacity: 0.8;
    background-image:
      linear-gradient(45deg, transparent 45%, rgba(255,255,255,.75) 45% 49%, transparent 49%),
      linear-gradient(-45deg, transparent 45%, rgba(255,255,255,.55) 45% 49%, transparent 49%),
      radial-gradient(circle, var(--paper-bright) 0 1px, transparent 1.5px);
    background-position: 3.7rem 2.2rem, 6.2rem 5.1rem, 0 0;
    background-size: 7.4rem 7.4rem, 7.4rem 7.4rem, 2.3rem 2.3rem;
  }

  .hero__sun {
    position: absolute;
    top: 8%;
    right: 6%;
    width: clamp(22rem, 42vw, 42rem);
    aspect-ratio: 1;
    border: 4px solid var(--ink);
    border-radius: 50%;
    background:
      repeating-linear-gradient(to bottom, transparent 0 3.1rem, rgba(89, 50, 181, 0.62) 3.15rem 3.3rem),
      var(--acid);
    box-shadow: 1.1rem 1.1rem 0 var(--ink);
  }

  .hero__mountains {
    position: absolute;
    right: -3%;
    bottom: 25%;
    left: -3%;
    height: 28%;
    opacity: 0.95;
    background: #24144c;
    clip-path: polygon(0 75%, 8% 55%, 15% 68%, 24% 33%, 31% 56%, 40% 19%, 48% 58%, 57% 39%, 66% 67%, 74% 28%, 82% 60%, 90% 42%, 100% 69%, 100% 100%, 0 100%);
  }

  .hero__mountains::before {
    position: absolute;
    inset: 0;
    content: '';
    background: repeating-linear-gradient(to bottom, transparent 0 2.7rem, rgba(217,255,57,.13) 2.75rem 2.85rem);
  }

  .hero__grid {
    position: absolute;
    right: -10%;
    bottom: -8rem;
    left: -10%;
    height: 39%;
    opacity: 0.72;
    background-image:
      linear-gradient(rgba(217, 255, 57, 0.88) 2px, transparent 2px),
      linear-gradient(90deg, rgba(217, 255, 57, 0.88) 2px, transparent 2px);
    background-size: 4.2rem 2.2rem;
    transform: perspective(26rem) rotateX(61deg);
    transform-origin: top;
  }

  .hero__scanlines {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background: repeating-linear-gradient(to bottom, transparent 0 3px, var(--ink) 4px);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    min-height: calc(100svh - 2rem);
    padding: clamp(8.4rem, 15vh, 11.5rem) 0 5.2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    align-items: start;
    gap: clamp(4rem, 7vw, 8rem);
  }

  .hero__copy {
    position: relative;
    width: min(100%, 78rem);
    text-align: center;
  }

  .hero .eyebrow {
    margin-inline: auto;
    color: var(--acid);
  }

  .hero h1 {
    max-width: 12ch;
    margin: 1.8rem auto 0;
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 7.8vw, 9.5rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 0.82;
    text-transform: uppercase;
    text-shadow: 5px 5px 0 var(--ink);
  }

  .hero h1 span {
    color: var(--acid);
    -webkit-text-stroke: 2px var(--ink);
  }

  .hero h1 em,
  .manual h2 em,
  .system h2 em,
  .build h2 em,
  .closing h2 em {
    color: var(--hot);
    font-family: var(--font-display);
    font-style: normal;
    font-weight: inherit;
  }

  .hero__lead {
    max-width: 48rem;
    margin: 2rem auto 0;
    color: rgba(255, 248, 220, 0.82);
    font-family: var(--font-ui);
    font-size: clamp(0.78rem, 1.05vw, 0.92rem);
    line-height: 1.75;
  }

  .hero__lead strong {
    padding: 0 0.15rem;
    color: var(--ink);
    background: var(--cyan);
  }

  .hero .button-row {
    margin-top: 2rem;
    justify-content: center;
  }

  .hero .button--primary {
    box-shadow: 5px 5px 0 var(--ink), 8px 8px 0 var(--hot);
  }

  .hero .button--secondary {
    box-shadow: 5px 5px 0 var(--ink), 8px 8px 0 var(--cyan);
  }

  .hero__product {
    width: min(100%, 112rem);
    margin-inline: auto;
  }

  .hero__status {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    left: 0;
    min-height: 2rem;
    padding: 0 1.2rem;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    color: var(--paper-bright);
    border-top: 3px solid var(--ink);
    background: var(--hot);
    font-family: var(--font-ui);
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .hero__status span:first-child {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero__status i {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--ink);
    background: var(--acid);
  }

  .hero__status span:last-child {
    margin-left: auto;
  }

  .ticker {
    position: relative;
    z-index: 4;
    overflow: hidden;
    color: var(--ink);
    border-block: 3px solid var(--ink);
    background: var(--acid);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .ticker__track {
    width: max-content;
    min-height: 2.9rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    animation: ticker-run 22s linear infinite;
  }

  .ticker i {
    color: var(--hot);
    font-style: normal;
  }

  @keyframes ticker-run {
    to { transform: translateX(-50%); }
  }

  .manual {
    position: relative;
    overflow: hidden;
    padding: clamp(6rem, 11vw, 10rem) 0;
    background: var(--paper);
  }

  .manual::before {
    position: absolute;
    inset: 0;
    content: '';
    opacity: 0.26;
    background-image: radial-gradient(var(--ink) 0.7px, transparent 0.8px);
    background-size: 7px 7px;
  }

  .manual > .container {
    position: relative;
  }

  .manual__heading,
  .system__heading,
  .build__heading {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .manual h2,
  .system h2,
  .build h2,
  .closing h2 {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.3vw, 7.7rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .manual h2 em {
    color: var(--hot-dark);
    -webkit-text-stroke: 1px var(--ink);
    text-shadow: 4px 4px 0 var(--acid);
  }

  .manual__intro {
    position: relative;
    padding: 1.2rem 1.3rem;
    border: 3px solid var(--ink);
    background: var(--paper-bright);
    box-shadow: 7px 7px 0 var(--violet);
    transform: rotate(1.2deg);
  }

  .manual__intro > span {
    color: var(--hot);
    font-family: var(--font-ui);
    font-size: 1.4rem;
    font-weight: 900;
  }

  .manual__intro p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .principle-grid {
    margin-top: clamp(4rem, 8vw, 7rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .principle-card {
    min-height: 31rem;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    color: var(--paper-bright);
    border: 3px solid var(--ink);
    background: var(--ink);
    box-shadow: 7px 7px 0 var(--hot);
  }

  .principle-card:nth-child(2) {
    color: var(--ink);
    background: var(--cyan);
    box-shadow: 7px 7px 0 var(--violet);
    transform: translateY(1.4rem) rotate(-1deg);
  }

  .principle-card:nth-child(3) {
    background: var(--hot);
    box-shadow: 7px 7px 0 var(--acid);
    transform: rotate(1deg);
  }

  .principle-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px dashed currentColor;
    font-family: var(--font-ui);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
  }

  .principle-card__top span {
    color: var(--hot);
    font-size: 0.85rem;
    font-weight: 900;
  }

  .principle-card:nth-child(2) .principle-card__top span,
  .principle-card:nth-child(3) .principle-card__top span {
    color: var(--ink);
  }

  .principle-card__icon {
    height: 5rem;
    margin: 1.5rem 0;
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
  }

  .principle-card__icon i {
    width: 1.7rem;
    height: 1.7rem;
    display: block;
    border: 2px solid var(--ink);
    background: var(--paper-bright);
