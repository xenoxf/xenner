---
import AppWindow from '../components/AppWindow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { REPO } from '../config';

/* Preguntas que se hacen buscando "creador de notas". Respondidas en la propia
   página, sin marcado especial: es lo que la gente busca antes de decidir. */
const FAQ = [
  {
    q: '¿Es gratis?',
    a: 'Sí. No hay nada que pagar ni a lo que suscribirse. El código es abierto, con licencia MIT.',
  },
  {
    q: '¿Necesito internet?',
    a: 'No. Xenner no hace peticiones de red.',
  },
  {
    q: '¿Dónde se guardan mis notas?',
    a: 'En la carpeta que elijas, como archivos Markdown. No hay base de datos ni copia en la nube.',
  },
  {
    q: '¿Puedo abrirlas sin Xenner?',
    a: 'Sí. Son archivos de texto: se abren con el Bloc de notas o con cualquier editor.',
  },
];

const repo = REPO;

const TIDY = [
  {
    title: 'Una nota es un archivo',
    text: 'Sin base de datos ni formato oculto. El título es el nombre del archivo y el contenido es Markdown que puedes leer, copiar o versionar por tu cuenta.',
  },
  {
    title: 'Una biblioteca es una carpeta',
    text: 'Eliges la carpeta con el diálogo del sistema y xenner trabaja dentro. Mueve el disco a otro ordenador y tus notas siguen ahí.',
  },
  {
    title: 'Guardado sin sobrescrituras',
    text: 'Cada cambio se escribe de forma atómica. Si el archivo cambió por fuera, xenner lo detecta y te deja decidir.',
  },
];

const EDITOR = [
  { label: 'Encabezados, listas y citas', text: 'Formato mientras escribes, guardado como Markdown.' },
  { label: 'Tareas y tablas', text: 'Listas de tareas y tablas que siguen siendo texto plano.' },
  { label: 'Código, enlaces y fórmulas', text: 'Bloques de código, referencias y LaTeX.' },
  { label: 'Imágenes', text: 'Se guardan junto a la nota y se editan dentro.' },
];

/* Lo que la web no contaba y la app ya hace. */
const PIZARRA = [
  { label: 'Dibuja dentro de la nota', text: 'Doble clic y dibuja sobre el papel.' },
  { label: 'Formas, flechas y texto', text: 'Para esquemas y para etiquetar.' },
  { label: 'Deshacer', text: 'Cada trazo se puede volver atrás.' },
];
---

<BaseLayout>
  <Header />

  <main id="contenido">
    <!-- ================= PORTADA ================= -->
    <section class="hero">
      <div class="shell hero__inner">
        <div class="hero__copy">

          <h1 class="hero__title">
            Un creador de notas<br />
            <em>gratis y de código abierto.</em>
          </h1>

          <p class="hero__lead">
            Xenner es un creador de notas para el ordenador. Escribes en algo bonito y lo que
            queda guardado es un archivo Markdown en tu carpeta. También puedes cambiarle el
            aspecto, porque la interfaz son archivos de texto.
          </p>

          <div class="hero__cta">
            <a class="cta cta--fill" href="#editor">Ver cómo escribe</a>
            <a class="cta cta--line" href={repo} target="_blank" rel="noreferrer">Código en GitHub</a>
          </div>
        </div>

        <div class="hero__shot">
          <AppWindow class="hero__win" switch />
        </div>
      </div>
    </section>

    <!-- ================= LA IDEA ================= -->
    <section class="idea" aria-labelledby="idea-title">
      <div class="shell">
        <header class="head">
          <p class="label">La idea</p>
          <h2 class="head__title" id="idea-title">
            Nada se esconde<br />dentro del archivo.
          </h2>
        </header>

        <ul class="tidy">
          {TIDY.map((item, i) => (
            <li class="tidy__item reveal">
              <span class="tidy__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="tidy__title">{item.title}</h3>
              <p class="tidy__text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= EDITOR ================= -->
    <section class="editor" id="editor" aria-labelledby="editor-title">
      <div class="shell">
        <header class="head">
          <p class="label">Escribir</p>
          <h2 class="head__title" id="editor-title">
            Bonito por fuera.<br />Markdown por dentro.
          </h2>
          <p class="head__lead">
            El editor visual no guarda un formato propietario: escribe Markdown. Lo que ves
            formateado y lo que hay en el disco son lo mismo.
          </p>
        </header>

        <div class="editor__shot">
          <AppWindow variant="formato" />
        </div>

        <ul class="features">
          {EDITOR.map((item) => (
            <li class="feature">
              <h3 class="feature__title">{item.label}</h3>
              <p class="feature__text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= PIZARRA ================= -->
    <section class="board" aria-labelledby="board-title">
      <div class="shell">
        <header class="head">
          <p class="label">Pizarra</p>
          <h2 class="head__title" id="board-title">
            Un dibujo<br />dentro de la nota.
          </h2>
          <p class="head__lead">
            Los trazos se guardan como un SVG junto al archivo, así que la nota sigue siendo
            un Markdown que cualquier visor entiende. Se edita con doble clic, en su sitio.
          </p>
        </header>

        <div class="board__shot">
          <AppWindow variant="pizarra" />
        </div>

        <ul class="features">
          {PIZARRA.map((item) => (
            <li class="feature feature--last">
              <h3 class="feature__title">{item.label}</h3>
              <p class="feature__text">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= ORGANIZAR ================= -->
    <section class="organize" id="organize" aria-labelledby="organize-title">
      <div class="shell">
        <header class="head">
          <p class="label">Organizar</p>
          <h2 class="head__title" id="organize-title">
            Carpetas de verdad,<br />no etiquetas.
          </h2>
          <p class="head__lead">
            El explorador refleja la estructura real de tu carpeta. Arrastra una nota a
            otra carpeta y se mueve de verdad, con sus imágenes incluidas.
          </p>
        </header>

        <div class="organize__shot">
          <AppWindow variant="reuniones" />
        </div>

        <ul class="organize__list">
          <li>Arrastrar para mover</li>
          <li>Clic derecho para cortar y pegar</li>
          <li>Renombrar desde el propio título</li>
          <li>Los adjuntos siguen a la nota</li>
        </ul>
        <p class="organize__note">
          El mismo clic derecho abre <b>Últimos cambios</b>: las versiones guardadas de esa
          nota, con la hora y el tamaño, y un botón para volver a cualquiera de ellas.
        </p>
      </div>
    </section>

    <!-- ================= APARIENCIA ================= -->
    <section class="look" id="look" aria-labelledby="look-title">
      <div class="shell">
        <header class="head">
          <p class="label">Apariencia</p>
          <h2 class="head__title" id="look-title">
            Se parece a cómo escribes.
          </h2>
          <p class="head__lead">
            Tipografía a elegir, tema claro u oscuro, y skins que son una carpeta
            de archivos tuyos: colores, imágenes, iconos propios y un archivo de
            CSS. Se cambian al instante y no hay que compilar nada.
          </p>
        </header>

        <ul class="looks">
          <li class="look__item">
            <span class="look__chip look__chip--theme" aria-hidden="true"><i></i></span>
            <b>Claro y oscuro</b>
            <span>Sigue al sistema o fíjalo tú.</span>
          </li>
          <li class="look__item">
            <span class="look__chip look__chip--fonts" aria-hidden="true">Ag</span>
            <b>Tipografías</b>
            <span>De la del sistema a las serif de libro.</span>
          </li>
          <li class="look__item">
            <span class="look__chip look__chip--hash" aria-hidden="true">#</span>
            <b>Skins propias</b>
            <span>Con tus imágenes, tus iconos y tu CSS.</span>
          </li>
        </ul>

        <p class="look__more">
          <a class="arrow" href="/doc/">
            Cómo se hace una skin
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
        </p>
      </div>
    </section>

    <!-- ================= PREGUNTAS ================= -->
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="shell">
        <header class="head">
          <p class="label">Preguntas</p>
          <h2 class="head__title" id="faq-title">
            Lo que se pregunta<br />antes de probarlo.
          </h2>
        </header>

        <div class="faq__list">
          {FAQ.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">
                {item.q}
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                  <path d="M3 6l5 5 5-5" />
                </svg>
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= CIERRE ================= -->
    <section class="close" aria-labelledby="close-title">
      <div class="shell close__inner">
        <h2 class="close__title" id="close-title">Tus ideas no deberían vivir en una base de datos.</h2>
        <p class="close__lead">
          Xenner es un creador de notas pequeño a propósito: gratis, sin cuentas y con el
          código abierto. Elige una carpeta y empieza a escribir.
        </p>
        <div class="close__cta">
          <a class="cta cta--fill" href={repo} target="_blank" rel="noreferrer">
            Ver en GitHub
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3h7v7M13 3 3 13"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ================= PORTADA ================= */

  .hero {
    padding: clamp(3rem, 7vw, 5rem) 0 var(--air);
  }

  /* Columna: el texto arriba, la app debajo a ancho completo. En una fila
     lateral la ventana quedaba encogida y no se apreciaba el producto. */
  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .hero__copy {
    max-width: 52rem;
    text-align: center;
    margin-inline: auto;
  }

  .hero__copy .label {
    justify-content: center;
  }

  .hero__title {
    margin-top: 1.4rem;
    font-size: var(--t-display);
    line-height: 1.04;
    /* El h1 lleva la palabra que se busca, así que es más largo que antes:
       con nowrap se salía de la caja en pantallas anchas. */
    text-wrap: balance;
  }

  .hero__title em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent-ink);
  }

  .hero__lead {
    margin: 1.6rem auto 0;
    max-width: 38rem;
    color: var(--ink-2);
    font-size: var(--t-md);
    line-height: 1.65;
    text-wrap: balance;
  }

  .hero__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
  }

  .hero__shot {
    /* La ventana ocupa todo el ancho disponible: es la protagonista. */
    width: 100%;
  }

  .hero__win {
    animation: settle var(--t-slow) var(--ease) both;
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  /* ================= CABECERA DE SECCIÓN ================= */

  .head {
    max-width: 38rem;
  }

  .head__title {
    margin-top: 1.1rem;
    font-family: var(--serif);
    font-size: clamp(1.875rem, 4vw, var(--t-2xl));
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .head__lead {
    margin-top: 1.1rem;
    color: var(--ink-2);
    font-size: var(--t-md);
    line-height: 1.65;
  }

  /* ================= IDEA ================= */

  .idea {
    padding: var(--air) 0;
    border-top: 1px solid var(--line);
  }

  .tidy {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .tidy__n {
    font-family: var(--mono);
    font-size: var(--t-xs);
    color: var(--accent-ink);
  }

  .tidy__title {
    margin-top: 0.8rem;
    font-size: var(--t-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .tidy__text {
    margin-top: 0.65rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.7;
  }

  /* ================= EDITOR ================= */

  .editor {
    padding: var(--air) 0;
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .editor__shot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .features {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(2rem, 5vw, 4rem);
  }

  .feature {
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }

  .feature__title {
    font-size: var(--t-md);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .feature__text {
    margin-top: 0.4rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.65;
  }

  /* ================= PIZARRA ================= */

  .board {
    padding: var(--air) 0;
  }

  .board__shot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* Tres tarjetas y la última ocupa la fila entera. */
  .feature--last {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--line);
  }

  .organize__note {
    margin-top: 1.4rem;
    max-width: 42rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.7;
  }

  .organize__note b {
    color: var(--ink);
    font-weight: 600;
  }

  /* ================= ORGANIZAR ================= */

  .organize {
    padding: var(--air) 0;
  }

  .organize__shot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .organize__list {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--line);
    overflow: hidden;
  }

  .organize__list li {
    padding: 1.15rem 1.25rem;
    background: var(--bg);
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  /* ================= APARIENCIA ================= */

  .look {
    padding: var(--air) 0;
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .looks {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .look__more {
    margin-top: 1.75rem;
  }

  .look__item {
    padding: 1.4rem;
    display: grid;
    gap: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
  }

  .look__item b {
    margin-top: 0.5rem;
    font-size: var(--t-base);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .look__item > span:last-child {
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.6;
  }

  .look__chip {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 9px;
    border: 1px solid var(--line-strong);
    background: var(--sunken);
  }

  /* Interruptor claro/oscuro: se lee de un vistazo. */
  .look__chip--theme {
    width: 2.6rem;
    height: 1.5rem;
    border-radius: 999px;
    background: #2a2a28;
    border: 0;
    justify-content: start;
    padding-inline: 3px;
  }

  .look__chip--theme i {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: #fbfaf8;
  }

  .look__chip--fonts {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink-2);
    background: var(--sunken);
  }

  .look__chip--hash {
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-ink);
    background: var(--accent-sub);
  }

  /* ================= PREGUNTAS ================= */

  .faq {
    padding: var(--air) 0;
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .faq__list {
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 46rem;
    display: grid;
  }

  .faq__item {
    border-top: 1px solid var(--line);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq__q {
    padding: 1.15rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink);
    font-size: var(--t-md);
    font-weight: 600;
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q svg {
    flex: none;
    color: var(--ink-3);
    transition: transform var(--t-fast) var(--ease);
  }

  .faq__item[open] .faq__q svg {
    transform: rotate(180deg);
  }

  .faq__a {
    padding-bottom: 1.25rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.7;
    text-wrap: pretty;
  }

  /* ================= CIERRE ================= */

  .close {
    padding: var(--air) 0;
    text-align: center;
  }

  .close__inner {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
  }

  .close__title {
    max-width: 22ch;
    font-family: var(--serif);
    font-size: clamp(1.875rem, 4.4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .close__lead {
    max-width: 30rem;
    color: var(--ink-2);
    font-size: var(--t-md);
    line-height: 1.65;
  }

  .close__cta {
    margin-top: 0.6rem;
  }

  /* ================= RESPONSIVE ================= */

  @media (max-width: 900px) {
    .tidy,
    .looks {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .organize__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .hero__title {
      text-wrap: balance;
    }

    .features {
      grid-template-columns: 1fr;
    }

    .feature--last {
      grid-column: auto;
      border-bottom: 0;
    }
  }

  @media (max-width: 460px) {
    .organize__list {
      grid-template-columns: 1fr;
    }

    .hero__cta {
      flex-direction: column;
    }
  }
</style>

<script>
  // La clase .js solo se añade si el script corre, para que .reveal pueda
  // ocultar contenido de forma segura (si el JS falla, nada se oculta).
  document.documentElement.classList.add('js');

  const targets = document.querySelectorAll('.reveal');

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );

    for (const el of targets) io.observe(el);
  } else {
    for (const el of targets) el.classList.add('is-in');
  }
</script>
