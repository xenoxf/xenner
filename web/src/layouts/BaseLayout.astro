---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Xenner es un editor de notas de escritorio con skins editables en archivos TXT. Cambia la interfaz, usa su fallback integrado y guarda las notas localmente.',
  image = '/og-xenner.png',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · xenner` : 'xenner: editor de notas con skins TXT';
const siteURL = Astro.site ? new URL('/', Astro.site) : new URL('/', Astro.url);
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImageURL = new URL(image, siteURL);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteURL.href}#website`,
      url: siteURL.href,
      name: 'xenner',
      inLanguage: 'es',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteURL.href}#app`,
      name: 'xenner',
      description,
      softwareVersion: '0.1.0',
      applicationCategory: 'UtilitiesApplication',
      isAccessibleForFree: true,
      license: 'https://opensource.org/license/mit',
      codeRepository: 'https://github.com/acosador116/xenner',
      image: {
        '@type': 'ImageObject',
        url: socialImageURL.href,
        width: 1200,
        height: 630,
      },
      url: siteURL.href,
      inLanguage: 'es',
      offers: {
        '@type': 'Offer',
        price: 0,
      },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5932b5" />
    <meta name="color-scheme" content="light" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="xenner" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Xenner con una interfaz retro construida mediante archivos de skin TXT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Xenner con una interfaz retro construida mediante archivos de skin TXT" />

    <title>{pageTitle}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
