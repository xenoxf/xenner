---
import { REPO, SITE_NAME } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Token de Search Console. Por defecto, el ya verificado en el repo. */
  googleVerification?: string;
  /**
   * A dónde lleva el enlace «Saltar al contenido». Cada layout tiene su
   * contenedor y por eso lo declara: el de la documentación es su propio
   * `<main>`, no el `<main id="contenido">` de las páginas de la guía. Con un
   * destino que no existe el enlace no hace nada, y eso no se ve en ningún sitio.
   */
  skipHref?: string;
}

const {
  title,
  description = 'Xenner es un creador de notas para el ordenador. Tus notas son archivos Markdown en tu carpeta. Gratis, de código abierto y con el aspecto en archivos de texto.',
  image = '/og-xenner.png',
  noindex = false,
  googleVerification =
    import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ??
    'fa6zFON181emDwrvIUEtbd_oiy5bwslWzIokdl-_An4',
  skipHref = '#contenido',
} = Astro.props;

/* El título por defecto lleva la palabra que se busca ("creador de notas") y
   se queda en 55 caracteres, dentro del rango que Google no recorta. */
const pageTitle = title ?? 'Xenner — creador de notas gratis y de código abierto';
const siteURL = Astro.site ? new URL('/', Astro.site) : new URL('/', Astro.url);
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImageURL = new URL(image, siteURL);
const repo = REPO;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteURL.href}#website`,
      url: siteURL.href,
      name: SITE_NAME,
      description,
      inLanguage: 'es',
      publisher: { '@id': `${siteURL.href}#app` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: pageTitle,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${siteURL.href}#website` },
      about: { '@id': `${siteURL.href}#app` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteURL.href}#app`,
      name: 'Xenner',
      description,
      softwareVersion: '0.1.0',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Windows, macOS, Linux',
      softwareRequirements: 'Node 22.12 o superior, pnpm y Rust estable (para compilar desde el código)',
      isAccessibleForFree: true,
      license: 'https://opensource.org/license/mit',
      codeRepository: repo,
      sameAs: [repo],
      keywords: ['creador de notas', 'editor de notas', 'notas Markdown'],
      featureList: [
        'Editor visual que guarda Markdown',
        'La interfaz son archivos de texto',
        'Sin cuentas, sin nube y de código abierto',
      ],
      image: {
        '@type': 'ImageObject',
        url: socialImageURL.href,
        width: 1200,
        height: 630,
      },
      url: siteURL.href,
      inLanguage: 'es',
      offers: {
        '@type': 'Offer',
        price: 0,
        priceCurrency: 'EUR',
      },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- La web es de papel claro siempre (ver :root en global.css). Anunciar
         soporte de oscuro hacía que la barra del navegador se pusiera oscura
         sobre una página clara. -->
    <meta name="theme-color" content="#fbfaf8" />
    <meta name="color-scheme" content="light" />
    <meta name="application-name" content="Xenner" />
    <meta name="apple-mobile-web-app-title" content="Xenner" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <!-- Verificación de propiedad en Search Console. Google pide que el valor
         coincida carácter a carácter; se puede sobreescribir con
         PUBLIC_GOOGLE_SITE_VERIFICATION sin tocar el código. -->
    <meta name="google-site-verification" content={googleVerification} />

    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Xenner" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Xenner, editor de notas que trabaja sobre una carpeta de Markdown" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Xenner, editor de notas que trabaja sobre una carpeta de Markdown" />

    <title>{pageTitle}</title>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href={skipHref}>Saltar al contenido</a>
    <slot />
  </body>
</html>
