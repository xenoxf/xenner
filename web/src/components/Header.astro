---
import Brand from './Brand.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
---

<header class="site-header">
  <div class="site-header__inner">
    <Brand />

    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#filosofia">Filosofía</a>
      <a href="#skins">Skins</a>
      <a href="#construccion">Construcción</a>
    </nav>

    <a class="header-cta" href={sourceUrl} target="_blank" rel="noreferrer">
      Ver código
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>

    <details class="mobile-nav">
      <summary aria-label="Abrir menú">
        <span></span><span></span>
      </summary>
      <nav aria-label="Navegación móvil">
        <a href="#filosofia">Filosofía</a>
        <a href="#skins">Skins</a>
        <a href="#construccion">Construcción</a>
        <a href={sourceUrl} target="_blank" rel="noreferrer">Código ↗</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    width: 100%;
    color: #f4f7f3;
  }

  .site-header__inner {
    width: min(100% - 3rem, 78rem);
    min-height: 5.5rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .desktop-nav a,
  .header-cta {
    color: rgba(244, 247, 243, 0.72);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .desktop-nav a:hover,
  .header-cta:hover {
    color: #fff;
  }

  .header-cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #b7cee1;
  }

  .header-cta svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .mobile-nav {
    display: none;
    justify-self: end;
  }

  .mobile-nav summary {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-content: center;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary span {
    width: 1rem;
    height: 1px;
    display: block;
    background: currentColor;
  }

  .mobile-nav nav {
    position: absolute;
    top: 4.7rem;
    right: 1.5rem;
    width: min(16rem, calc(100vw - 3rem));
    display: grid;
    padding: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.1rem;
    background: rgba(13, 22, 18, 0.96);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(18px);
  }

  .mobile-nav a {
    padding: 0.9rem 0.8rem;
    color: #eef5ef;
    border-radius: 0.7rem;
    text-decoration: none;
  }

  .mobile-nav a:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  @media (max-width: 760px) {
    .site-header__inner {
      width: min(100% - 2rem, 78rem);
      min-height: 4.8rem;
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
