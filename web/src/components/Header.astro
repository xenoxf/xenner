---
import Brand from './Brand.astro';
import { REPO } from '../config';
---

<header class="top">
  <div class="top__inner">
    <Brand />

    <nav class="top__nav" aria-label="Navegación principal">
      <a href="/#editor">Editor</a>
      <a href="/#organize">Carpetas</a>
      <a href="/#look">Apariencia</a>
      <a href="/doc/">Documentación</a>
    </nav>

    <a class="cta cta--fill top__cta" href={REPO} target="_blank" rel="noreferrer">
      Ver en GitHub
    </a>

    <details class="top__menu">
      <summary>
        <span class="visually-hidden">Abrir menú</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </svg>
      </summary>
      <nav aria-label="Navegación móvil">
        <a href="/#editor">Editor</a>
        <a href="/#organize">Carpetas</a>
        <a href="/#look">Apariencia</a>
        <a href="/doc/">Documentación</a>
        <a href={REPO} target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .top {
    position: sticky;
    z-index: 60;
    top: 0;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(150%) blur(12px);
    -webkit-backdrop-filter: saturate(150%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-mid) var(--ease), background var(--t-mid) var(--ease);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .top {
      background: var(--bg);
    }
  }

  .top[data-stuck='true'] {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }

  .top__inner {
    width: var(--shell);
    min-height: 3.9rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .top__nav {
    margin-right: auto;
    display: flex;
    gap: 0.15rem;
  }

  .top__nav a {
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    color: var(--ink-2);
    font-size: var(--t-sm);
    font-weight: 500;
    transition: color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
  }

  .top__nav a:hover {
    color: var(--ink);
    background: var(--sunken);
  }

  .top__cta {
    min-height: 2.35rem;
    padding-inline: 1.05rem;
    font-size: var(--t-xs);
  }

  /* ---------- móvil ---------- */

  .top__menu {
    display: none;
    margin-left: auto;
  }

  .top__menu summary {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--ink);
    background: var(--surface);
    list-style: none;
  }

  .top__menu summary::-webkit-details-marker {
    display: none;
  }

  .top__menu nav {
    position: absolute;
    top: calc(100% + 1px);
    right: 1.25rem;
    left: 1.25rem;
    padding: 0.4rem;
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--lift-3);
  }

  .top__menu nav a {
    padding: 0.75rem 0.85rem;
    border-radius: 9px;
    color: var(--ink);
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .top__menu nav a:hover {
    background: var(--sunken);
  }

  @media (max-width: 820px) {
    .top__nav,
    .top__cta {
      display: none;
    }

    .top__menu {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.top');
  const menu = document.querySelector<HTMLDetailsElement>('.top__menu');

  const onScroll = () => {
    if (header) header.dataset.stuck = String(window.scrollY > 6);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
