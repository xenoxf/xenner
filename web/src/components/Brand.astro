---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a class:list={['brand', className]} href="/" aria-label="xenner, inicio">
  <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
    <g fill="currentColor">
      <rect x="3" y="3" width="10" height="10" rx="2.6" opacity="0.95"></rect>
      <rect x="19" y="3" width="10" height="10" rx="2.6" opacity="0.4"></rect>
      <rect x="11" y="11" width="10" height="10" rx="2.6" opacity="0.7"></rect>
      <rect x="3" y="19" width="10" height="10" rx="2.6" opacity="0.4"></rect>
      <rect x="19" y="19" width="10" height="10" rx="2.6" opacity="0.95"></rect>
    </g>
  </svg>
  <span class="brand__name">xenner</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    color: var(--ink);
  }

  .brand__mark {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    color: var(--accent);
  }

  .brand__name {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    transition: color var(--t-fast) var(--ease);
  }

  .brand:hover .brand__name {
    color: var(--accent-ink);
  }
</style>
