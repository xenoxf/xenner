# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas
.env

# Generated by Gradle: intermediates, class files and merged resources. The
# project itself IS versioned — it is what `tauri android build` reads — but the
# build output inside it is not, and it runs to a gigabyte per ABI.
/gen/android/**/build/
/gen/android/.gradle/
/gen/android/local.properties

# The debug keystore that Gradle generates. It is a throwaway per machine, and
# committing one is how debug keys end up in places they should not be.
/gen/android/**/debug.keystore
/gen/android/**/keystore.properties
