---
import Brand from './Brand.astro';

const sourceUrl = 'https://github.com/acosador116/xenner';
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__identity">
      <Brand />
    </div>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#filosofia"><span>01</span> idea</a>
      <a href="#skins"><span>02</span> skins</a>
      <a href="#construccion"><span>03</span> build</a>
    </nav>

    <a class="header-cta" href={sourceUrl} target="_blank" rel="noreferrer">
      <i aria-hidden="true"></i>
      CÓDIGO REAL
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
      </svg>
    </a>

    <details class="mobile-nav">
      <summary aria-label="Abrir menú">
        <span>menu</span>
      </summary>
      <nav aria-label="Navegación móvil">
        <a href="#filosofia"><span>01</span> La idea</a>
        <a href="#skins"><span>02</span> Skins</a>
        <a href="#construccion"><span>03</span> Build</a>
        <a href={sourceUrl} target="_blank" rel="noreferrer"><span>↗</span> Código</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    width: 100%;
    color: var(--paper-bright);
  }

  .site-header::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    content: '';
    background: linear-gradient(90deg, var(--hot) 0 24%, transparent 24% 25%, var(--cyan) 25% 48%, transparent 48% 49%, var(--acid) 49% 72%, transparent 72% 73%, var(--violet) 73% 100%);
  }

  .site-header__inner {
    width: min(calc(100% - var(--gutter) - var(--gutter)), var(--container));
    min-height: 5.25rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .site-header__identity {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .desktop-nav {
    height: 100%;
    display: flex;
    align-items: center;
  }

  .desktop-nav a {
    height: 100%;
    padding: 0 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: rgba(255, 248, 220, 0.8);
    border-left: 1px solid rgba(255, 248, 220, 0.2);
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 120ms ease, background-color 120ms ease;
  }

  .desktop-nav a:last-child {
    border-right: 1px solid rgba(255, 248, 220, 0.2);
  }

  .desktop-nav a:hover {
    color: var(--ink);
    background: var(--acid);
  }

  .desktop-nav span {
    color: var(--hot);
    font-size: 0.52rem;
  }

  .desktop-nav a:hover span {
    color: var(--ink);
  }

  .header-cta {
    justify-self: end;
    min-height: 2.25rem;
    padding: 0 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    color: var(--ink);
    border: 2px solid var(--paper-bright);
    background: var(--cyan);
    box-shadow: 3px 3px 0 var(--hot);
    font-family: var(--font-ui);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: transform 100ms ease, box-shadow 100ms ease;
  }

  .header-cta:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--hot);
  }

  .header-cta i {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid var(--ink);
    background: var(--acid);
  }

  .header-cta svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .mobile-nav {
    display: none;
    justify-self: end;
  }

  .mobile-nav summary {
    min-height: 2.35rem;
    padding: 0 0.7rem;
    display: flex;
    align-items: center;
    color: var(--paper-bright);
    border: 2px solid var(--paper-bright);
    background: var(--hot-dark);
    box-shadow: 3px 3px 0 var(--cyan);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav nav {
    position: absolute;
    top: 4.2rem;
    right: 1rem;
    width: min(17rem, calc(100vw - 2rem));
    display: grid;
    padding: 0.5rem;
    border: 3px solid var(--paper-bright);
    background: var(--ink);
    box-shadow: 6px 6px 0 var(--hot);
  }

  .mobile-nav a {
    padding: 0.9rem 0.75rem;
    display: flex;
    gap: 0.65rem;
    color: var(--paper-bright);
    border-bottom: 1px dashed #71677b;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-nav a:last-child {
    border-bottom: 0;
  }

  .mobile-nav a:hover {
    color: var(--ink);
    background: var(--cyan);
  }

  .mobile-nav a span {
    color: var(--hot);
  }

  .mobile-nav a:hover span {
    color: var(--ink);
  }

  @media (max-width: 240px) {
    .site-header__inner {
      gap: 0.45rem;
    }

    .site-header__identity :global(.brand > span) {
      display: none;
    }

    .mobile-nav summary {
      padding-inline: 0.5rem;
    }
  }

  @media (max-width: 760px) {
    .site-header__inner {
      min-height: 4.5rem;
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
