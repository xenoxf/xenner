---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GUIDE } from '../data/guide';
---

<BaseLayout title="Página no encontrada" description="Esta página no existe." noindex>
  <Header />

  <main class="nf" id="contenido">
    <div class="shell nf__inner">
      <h1 class="nf__title">Esta nota<br />no está aquí.</h1>
      <p class="nf__lead">
        La dirección no existe. Quizá la moviste de sitio, o el enlace tenía un error.
      </p>
      <div class="nf__cta">
        <a class="cta cta--fill" href="/">Volver al inicio</a>
      </div>
      <ul class="nf__links">
        {GUIDE.map((page) => <li><a href={page.path}>{page.label}</a></li>)}
      </ul>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .nf {
    min-height: 74vh;
    padding: var(--air) 0;
    display: grid;
    align-content: center;
  }

  .nf__inner {
    max-width: 30rem;
    display: grid;
    gap: 0.9rem;
  }

  .nf__title {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 5.4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .nf__lead {
    color: var(--ink-2);
    font-size: var(--t-md);
  }

  .nf__cta {
    margin-top: 0.6rem;
  }

  .nf__links {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  .nf__links a {
    color: var(--ink-2);
    font-size: var(--t-sm);
    text-decoration: none;
  }

  .nf__links a:hover {
    color: var(--accent-ink);
  }
</style>
