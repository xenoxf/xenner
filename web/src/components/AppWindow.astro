---
import './appwindow.css';

interface Props {
  class?: string;
  variant?: 'idea' | 'formato' | 'pizarra' | 'reuniones';
  /** Solo el hero trae el interruptor: es el único que hace falta. */
  switch?: boolean;
}

const { class: className, variant = 'idea', switch: hasSwitch = false } = Astro.props;

const TREE = [
  { name: 'Ideas', depth: 0, folder: true, active: variant !== 'reuniones' },
  { name: 'Notas de escritorio', depth: 1, folder: false, active: variant === 'idea' },
  { name: 'Cómo se guarda', depth: 1, folder: false, active: variant === 'formato' },
  { name: 'Esquema del proyecto', depth: 1, folder: false, active: variant === 'pizarra' },
  { name: 'Borradores', depth: 1, folder: false, active: false },
  { name: 'Trabajo', depth: 0, folder: true, active: variant === 'reuniones' },
  { name: 'Reuniones', depth: 1, folder: false, active: false },
  { name: 'Plan', depth: 1, folder: false, active: false },
  { name: 'Lectura', depth: 0, folder: true, active: false },
];

type Block =
  | { kind: 'p'; text: string }
  | { kind: 'task'; text: string; done: boolean }
  | { kind: 'h4'; text: string }
  | { kind: 'code'; text: string }
  | { kind: 'link'; text: string }
  | { kind: 'board' };

interface Note {
  crumb: readonly string[];
  title: string;
  blocks: readonly Block[];
  quote: string;
}

const COPY: Record<NonNullable<Props['variant']>, Note> = {
  idea: {
    crumb: ['Ideas', 'Notas de escritorio.md'],
    title: 'Notas de escritorio',
    blocks: [
      {
        kind: 'p',
        text: 'El título de esta nota es el nombre del archivo. Si lo cambio, el archivo se renombra. Lo que escribo es un Markdown que puedo abrir con cualquier otro editor.',
      },
      {
        kind: 'p',
        text: 'El formato rico se guarda como texto legible, con los adjuntos en una carpeta de recursos junto al archivo.',
      },
      { kind: 'task', text: 'Elegir la carpeta de la biblioteca', done: true },
      { kind: 'task', text: 'Escribir la primera nota', done: false },
      { kind: 'task', text: 'Arrastrar la nota a otra carpeta', done: false },
    ],
    quote: 'Texto pleno para el papel, texto pleno también para el contenido.',
  },

  formato: {
    crumb: ['Ideas', 'Cómo se guarda.md'],
    title: 'Cómo se guarda',
    blocks: [
      { kind: 'h4', text: 'Markdown, no un formato propio' },
      {
        kind: 'p',
        text: 'Pongo negrita, hago una lista o escribo código mientras escribo. Abro el archivo por fuera y ahí está, con sus asteriscos y sus almohadillas.',
      },
      { kind: 'code', text: '- [x] guardar\n- [ ] revisar\n\n**Listo** para mandar' },
      {
        kind: 'link',
        text: 'La especificación del formato está en commonmark.org',
      },
    ],
    quote: 'Si algún día cambio de editor, mis notas siguen ahí.',
  },

  pizarra: {
    crumb: ['Ideas', 'Esquema del proyecto.md'],
    title: 'Esquema del proyecto',
    blocks: [
      {
        kind: 'p',
        text: 'El diagrama está dentro de la nota, en la línea donde lo estaba escribiendo. Se edita con doble clic y se guarda junto al archivo.',
      },
      { kind: 'board' },
    ],
    quote: 'Un dibujo es un SVG en la carpeta de recursos. Nada más.',
  },

  reuniones: {
    crumb: ['Trabajo', 'Reunión del lunes.md'],
    title: 'Reunión del lunes',
    blocks: [
      {
        kind: 'p',
        text: 'Esta nota vivía en otra carpeta. Arrastré el archivo hasta Trabajo y xenner movió con él la carpeta de imágenes, para que los enlaces sigan funcionando.',
      },
      { kind: 'p', text: 'El Markdown no ha cambiado: es el mismo archivo, en otro sitio.' },
      { kind: 'task', text: 'Mover el acta a Trabajo', done: true },
      { kind: 'task', text: 'Comprobar que las imágenes siguen en su sitio', done: true },
      { kind: 'task', text: 'Enviar el resumen', done: false },
    ],
    quote: 'Mover una nota es mover un archivo. Nada más.',
  },
};

const c = COPY[variant];
---

{/*
  La ventana se dibuja con CSS contra los mismos tokens que la app, así que no
  hay imágenes que se queden viejas. El interruptor claro/oscuro es la única
  interacción: un checkbox de CSS, sin JavaScript.
*/}
<div class:list={['win', className]} data-mock="xenner">
  <div class="win__bar">
    <div class="win__dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="win__saved"><i aria-hidden="true"></i> Guardado</p>
    {
      hasSwitch && (
        <label class="win__mode">
          <span class="visually-hidden">Ver las maquetas en modo oscuro</span>
          <input type="checkbox" />
          <span class="win__mode-track" aria-hidden="true"></span>
        </label>
      )
    }
  </div>

  <div class="win__body">
    <nav class="win__side" aria-label="Explorador de la biblioteca">
      <div class="win__side-head">
        <span>Notas</span>
        <span class="win__side-tools" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2 12.5v-9h4l1.2 1.5H14v7.5z"></path></svg>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5V5h-2.5"></path></svg>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M8 5.2A2.8 2.8 0 1 0 8 10.8 2.8 2.8 0 0 0 8 5.2M8 1.8v1.6M8 12.6v1.6M14.2 8h-1.6M3.4 8H1.8M12.4 3.6l-1.1 1.1M4.7 11.3l-1.1 1.1M12.4 12.4l-1.1-1.1M4.7 4.7 3.6 3.6"></path></svg>
        </span>
      </div>
      <p class="win__new"><b>+</b> Nueva nota</p>
      <ul class="win__tree">
        {TREE.map((node) => (
          <li class="win__node" data-depth={node.depth} data-active={node.active}>
            {node.folder ? (
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2 4.5h4l1.2 1.5H14v6H2z"></path></svg>
            ) : (
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4 2.5h5l3 3v8H4zM9 2.5v3h3"></path></svg>
            )}
            <span>{node.name}</span>
          </li>
        ))}
      </ul>
      <p class="win__brand">xenner</p>
    </nav>

    <article class="win__doc">
      <p class="win__crumb"><b>{c.crumb[0]}</b> / {c.crumb[1]}</p>
      <h3>{c.title}</h3>

      {c.blocks.map((block) => {
        if (block.kind === 'task') {
          return <p class="win__task" data-done={block.done}>{block.text}</p>;
        }
        if (block.kind === 'h4') {
          return <h4>{block.text}</h4>;
        }
        if (block.kind === 'code') {
          return <pre class="win__code">{block.text}</pre>;
        }
        if (block.kind === 'link') {
          return (
            <p class="win__link">
              <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6.5 9.5 9.5 6.5M7 4.5 8.6 3a2.8 2.8 0 0 1 4 4L11 12.4M5 11.5 3.4 13a2.8 2.8 0 0 1-4-4L1 7.5"></path></svg>
              {block.text}
            </p>
          );
        }
        if (block.kind === 'board') {
          return (
            <div class="win__paper">
              <span class="win__paper-label">Pizarra</span>
              <svg viewBox="0 0 260 96" role="img" aria-label="Dibujo con tres figuras seleccionadas por un rectángulo">
                <g class="win__shapes">
                  <rect x="14" y="16" width="76" height="52" rx="5"></rect>
                  <rect x="112" y="26" width="120" height="34" rx="17"></rect>
                  <path d="M40 82 96 46"></path>
                </g>
                <g class="win__handles">
                  <rect x="6" y="8" width="92" height="68" rx="6"></rect>
                  <rect x="104" y="18" width="136" height="50" rx="6"></rect>
                  <rect x="32" y="74" width="72" height="16" rx="6"></rect>
                </g>
                <rect class="win__marquee" x="2" y="2" width="244" height="90" rx="5"></rect>
                <circle class="win__grip" cx="110" cy="89" r="5"></circle>
              </svg>
            </div>
          );
        }
        return <p>{block.text}</p>;
      })}

      <p class="win__quote">{c.quote}</p>
    </article>
  </div>

  {/*
    El dock de la app son tres botones y flotan abajo en el centro. Aquí es
    puramente decorativo: aria-hidden y sin foco, para no prometer interacción
    que no existe.
  */}
  <div class="win__dock" aria-hidden="true">
    <span class="win__dock-btn win__dock-btn--wide">Texto</span>
    <span class="win__dock-btn">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2.5 4.5h15v11h-15zM2.5 12l4-3.5 3 2.5 3-4 5 4.5"></path></svg>
    </span>
    <span class="win__dock-btn">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16 16 4M16 4h-5M16 4v5"></path></svg>
    </span>
  </div>
</div>
